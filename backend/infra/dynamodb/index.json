      "AttributeType": "S"
    },
    {
      "AttributeName": "last_seen_at",
      "AttributeType": "S"
    },
    {
      "AttributeName": "match_pk",
      "AttributeType": "S"
    },
    {
      "AttributeName": "service_id",
      "AttributeType": "S"
    },
    {
      "AttributeName": "status_pk",
      "AttributeType": "S"
    }
  ],
