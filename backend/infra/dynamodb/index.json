          "KeyType": "HASH"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
      }
    },
    {
      "IndexName": "status-index",
      "KeySchema": [
        {
          "AttributeName": "status_pk",
          "KeyType": "HASH"
        },
        {
          "AttributeName": "last_seen_at",
          "KeyType": "RANGE"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
